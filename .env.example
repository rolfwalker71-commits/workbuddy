# Public HTTPS origin behind reverse proxy (no trailing slash).
# Required for cookies, redirects, Google and Microsoft OAuth.
# Google Console redirect must be exactly: {APP_PUBLIC_URL}/api/google/oauth/callback
# Example:
# APP_PUBLIC_URL=https://workbuddy.rolfwalker.ch
# APP_PUBLIC_URL=https://workbuddy.example.com

# Container/app listen on 3311 (not 3000). Host mapping: WORKBUDDY_PORT → container 3311
PORT=3311
WORKBUDDY_PORT=3311
WORKBUDDY_IMAGE_TAG=latest

# Login (env-admin)
WORKBUDDY_USERNAME=admin
# npm run auth:secrets -- 'your secure password'
WORKBUDDY_PASSWORD_HASH=
WORKBUDDY_SESSION_SECRET=

# Optional extra key for at-rest encryption (otherwise SESSION_SECRET is used)
# DATA_ENCRYPTION_KEY=

# Shared Microsoft Entra app (one registration for all users)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=organizations

# Shared MARI REST login. Per-user field on /account is Personalnummer only.
MARI_REST_BASE_URL=https://marirestservice.an-group.international
MARI_REST_USERNAME=
MARI_REST_PASSWORD=

# Optional company-wide AI. Prefer Admin → Firmen-KI.
# Do not set OPENAI_API_KEY — that env is ignored.
# COMPANY_AI_API_KEY=
# COMPANY_AI_KIND=openai
# COMPANY_AI_MODEL=gpt-4o-mini
# COMPANY_AI_BASE_URL=
# COMPANY_AI_DISABLED=

# Web Push (VAPID) — optional override. If unset, WorkBuddy generates keys
# into the SQLite settings table on first use (npm run push:vapid is optional).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

DATABASE_PATH=/app/data/supportdesk.sqlite
