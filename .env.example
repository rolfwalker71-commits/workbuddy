# Public HTTPS origin behind reverse proxy (no trailing slash).
# Required for cookies, redirects and Microsoft OAuth. Example:
# APP_PUBLIC_URL=https://workbuddy.rolfwalker.ch
# APP_PUBLIC_URL=https://workbuddy.example.com

# Container/app listen on 3311 (not 3000). Host mapping: WORKBUDDY_PORT → container 3311
PORT=3311
WORKBUDDY_PORT=3311
WORKBUDDY_IMAGE_TAG=latest

# Login (env-admin)
WORKBUDDY_USERNAME=admin
# npm run auth:secrets -- 'your secure password'
WORKBUDDY_PASSWORD_HASH=
WORKBUDDY_SESSION_SECRET=

# Optional extra key for at-rest encryption (otherwise SESSION_SECRET is used)
# DATA_ENCRYPTION_KEY=

# Shared Microsoft Entra app (one registration for all users)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=organizations

# Shared MARI base URL (credentials are per user on /account)
MARI_REST_BASE_URL=https://marirestservice.an-group.international

DATABASE_PATH=/app/data/supportdesk.sqlite
